* text=auto
*.mjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.pdf binary
# Preserve exported CRLF bytes; recognize CR as part of the line ending in checks.
data/raw/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/processed/static-2026-10-21/training.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/processed/static-2026-10-21/testing.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# The angle audit hashes its input protocol as exact bytes, like raw sources.
data/splits/angles-2026-10-22/protocol.json -text whitespace=cr-at-eol
